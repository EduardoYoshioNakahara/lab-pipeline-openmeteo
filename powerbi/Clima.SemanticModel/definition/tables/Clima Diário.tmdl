table 'Clima Diário'
	lineageTag: 75cdf546-61bd-4dc4-a047-26e101fbd182

	measure 'Temp. máx. média (°C)' = AVERAGE('Clima Diário'[Temp. máx. (°C)])
		formatString: 0.0
		lineageTag: 3a061199-d85f-4d62-b6ba-1d9723a43ecc

	measure 'Temp. mín. média (°C)' = AVERAGE('Clima Diário'[Temp. mín. (°C)])
		formatString: 0.0
		lineageTag: d7bb88f6-5b21-4e8e-9da4-69c62d558ed3

	measure 'Amplitude média (°C)' = AVERAGE('Clima Diário'[Amplitude (°C)])
		formatString: 0.0
		lineageTag: 8290bf0d-54fb-4eaa-9388-bd2c1979a0ab

	measure 'Recorde de calor (°C)' = MAX('Clima Diário'[Temp. máx. (°C)])
		formatString: 0.0
		lineageTag: 7beb3c41-1eb8-4d2b-a19c-0df71540fd2a

	measure 'Chuva total (mm)' = SUM('Clima Diário'[Chuva (mm)])
		formatString: #,0
		lineageTag: 79767783-76a4-451f-b618-3f48b906a9d1

	measure 'Chuva média mensal (mm)' = AVERAGEX(VALUES(Calendario[Início do mês]), [Chuva total (mm)])
		formatString: #,0
		lineageTag: 5bd5d2e8-9e85-448c-8722-3d6147b5da62

	measure 'Dias observados' = COUNTROWS('Clima Diário')
		formatString: #,0
		lineageTag: 02a9fe03-b7da-4bf2-b110-50ee703aa622

	measure 'Dias com chuva' = CALCULATE(COUNTROWS('Clima Diário'), 'Clima Diário'[Dia chuvoso] = TRUE())
		formatString: #,0
		lineageTag: efafaa1e-70b1-40a4-a3df-40b1fa14026d

	measure '% dias com chuva' = DIVIDE([Dias com chuva], [Dias observados])
		formatString: 0.0%
		lineageTag: 5f25d5b3-2084-48a3-a6ee-2bd7c3f24a24

	measure 'Última atualização' = MAX('Clima Diário'[Atualizado em])
		formatString: General Date
		lineageTag: 312f35e7-5580-4ec1-b09b-37b7ba44b786

