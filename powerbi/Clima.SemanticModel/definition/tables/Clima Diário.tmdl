	partition 'Clima Diário' = m
		mode: import
		source =
				let
				    Fonte = Databricks.Catalogs(DatabricksHost, DatabricksHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null]),
				    Catalogo = Fonte{[Name = "workspace"]}[Data],
				    Schema = Catalogo{[Name = "visualization_weather"]}[Data],
				    View = Schema{[Name = "vw_daily_weather"]}[Data],
				    Tipos = Table.TransformColumnTypes(View, {{"date", type date}, {"temperature_max_c", type number}, {"temperature_min_c", type number}, {"temperature_range_c", type number}, {"precipitation_mm", type number}, {"is_rainy_day", type logical}, {"updated_control", type datetime}}),
				    Traducao = [clear = "Céu limpo", cloudy = "Nublado", fog = "Neblina", rain = "Chuva", snow = "Neve", showers = "Pancadas", thunderstorm = "Tempestade", unknown = "Desconhecido"],
				    ComCondicao = Table.AddColumn(Tipos, "Condição", each if [weather_group] = null then "Desconhecido" else Record.FieldOrDefault(Traducao, [weather_group], "Desconhecido"), type text),
				    SemCodigo = Table.RemoveColumns(ComCondicao, {"weather_group"}),
				    Renomeadas = Table.RenameColumns(SemCodigo, {{"date", "Data"}, {"city_name", "Cidade"}, {"state", "UF"}, {"region", "Região"}, {"temperature_max_c", "Temp. máx. (°C)"}, {"temperature_min_c", "Temp. mín. (°C)"}, {"temperature_range_c", "Amplitude (°C)"}, {"precipitation_mm", "Chuva (mm)"}, {"is_rainy_day", "Dia chuvoso"}, {"updated_control", "Atualizado em"}})
				in
				    Renomeadas

	annotation PBI_ResultType = Table

