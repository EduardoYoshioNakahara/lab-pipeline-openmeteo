        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#5E6B7E"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5E6B7E"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#5E6B7E"
              }
            },
